# Copy this file to backend/.env (or repo-root .env) and fill in real values.
# Never commit the real .env file.

# ==================== SECURITY ====================
# Required in any real deployment — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Comma-separated list of frontend origins allowed to call this API, e.g.
# https://app.example.com,https://staging.example.com
# Leave as "*" only for local development.
ALLOWED_ORIGINS=*

# ==================== DATABASE ====================
# Defaults to a local SQLite file if unset.
DATABASE_URL=sqlite:///./ai_hr_saas.db

# ==================== LLM PROVIDER ====================
# If GROQ_API_KEY is set, Groq is used; otherwise the app falls back to a local Ollama server.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

OLLAMA_API_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b

# ==================== OUTBOUND EMAIL (optional) ====================
# Required only for the "send email" AI Hub action. Leave blank to disable it.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=

# ==================== OBSERVABILITY (optional) ====================
# Every LLM call and the job-application pipeline is always recorded locally
# (GET /api/observability/runs) — no config needed for that. Set this to also
# trace the same calls to LangSmith (smith.langchain.com) for a full tracing
# dashboard: latency, token usage, prompt/completion inspection.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hireai

# ==================== SERVER ====================
PORT=8000
