# Copy to backend/.env (or repo-root .env). Never commit the real file.

# ==================== CORE ====================
# development | production. In production the app refuses to start with a weak
# SECRET_KEY, ALLOWED_ORIGINS="*", or SQLite.
APP_ENV=development
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
# Comma-separated frontend origins, e.g. https://app.example.com
ALLOWED_ORIGINS=*
PORT=8000
# Set true only when running behind a reverse proxy you control (uses X-Forwarded-For for rate limits).
TRUST_PROXY=false

# ==================== DATABASE ====================
# PostgreSQL with the pgvector extension, then run `alembic upgrade head`.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_hr_saas

# ==================== REDIS (cache, rate limits, job queue) ====================
# Empty = in-process cache and threads (dev only). Set it and run `python worker.py` for durable background jobs.
REDIS_URL=

# ==================== FILE STORAGE (Cloudinary) ====================
# auto = Cloudinary when configured, otherwise local disk.
STORAGE_BACKEND=auto
# Get this from the Cloudinary console (Settings -> API Keys): cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=hireai/resumes
LOCAL_STORAGE_DIR=data/resumes
MAX_UPLOAD_MB=10

# ==================== RETRIEVAL ====================
EMBEDDING_MODEL=all-MiniLM-L6-v2
RERANKER_ENABLED=true
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# 0 = ignore the cross-encoder in the score, 1 = use only it. Tune with evaluation/run_retrieval.py.
RERANK_BLEND=0.3
RETRIEVE_K=50
RERANK_KEEP=20

# ==================== AUTH ====================
ACCESS_TOKEN_MINUTES=30
REFRESH_TOKEN_DAYS=7
MIN_PASSWORD_LENGTH=8
# A just-rotated refresh token presented again within this window is rejected without revoking the session (two tabs racing).
REFRESH_REUSE_GRACE_SECONDS=10
RATE_LIMIT_ENABLED=true

# ==================== LLM ====================
# GROQ_API_KEY set -> Groq first, local Ollama as fallback. Empty -> Ollama only.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_API_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
# Mask emails/phones/URLs and the candidate's name in prompts sent to Groq.
LLM_REDACT_PII=true

# ==================== EXTRACTION ====================
OCR_ENABLED=true
NER_ENABLED=true

# ==================== OUTBOUND EMAIL (optional) ====================
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=

# ==================== OBSERVABILITY ====================
LOG_FORMAT=text          # json in production
LOG_TO_FILE=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=hireai
